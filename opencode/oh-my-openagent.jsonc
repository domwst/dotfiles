{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "agents": {
    "sisyphus": {
      "model": "openai/gpt-5.4",
      "variant": "xhigh"
    },
    "prometheus": {
      "model": "openai/gpt-5.4",
      "reasoningEffort": "xhigh"
    },
    "atlas": {
      "model": "openai/gpt-5.4",
      "reasoningEffort": "medium"
    },
    "sisyphus-junior": {
      "model": "openai/gpt-5.4",
      "reasoningEffort": "medium"
    },
    "hephaestus": {
      "model": "openai/gpt-5.4",
      "reasoningEffort": "medium"
    },
    "oracle": {
      "model": "openai/gpt-5.4",
      "reasoningEffort": "high"
    },
    "momus": {
      "model": "openai/gpt-5.4",
      "reasoningEffort": "xhigh"
    },
    "librarian": {
      "model": "openai/gpt-5.4",
      "reasoningEffort": "low"
    },
    "explore": {
      "model": "openai/gpt-5.4",
      "reasoningEffort": "low"
    },
    "metis": {
      "model": "openai/gpt-5.4",
      "variant": "xhigh"
    }
  },
  "categories": {
    "quick": {
      "model": "openai/gpt-5.4",
      "reasoningEffort": "low"
    },
    "unspecified-low": {
      "model": "openai/gpt-5.4",
      "reasoningEffort": "low"
    },
    "unspecified-high": {
      "model": "openai/gpt-5.4",
      "reasoningEffort": "xhigh"
    },
    "writing": {
      "model": "openai/gpt-5.4",
      "reasoningEffort": "low"
    },
    "deep": {
      "model": "openai/gpt-5.4",
      "reasoningEffort": "high"
    },
    "artistry": {
      "model": "openai/gpt-5.4",
      "reasoningEffort": "medium"
    },
    "ultrabrain": {
      "model": "openai/gpt-5.4",
      "reasoningEffort": "xhigh"
    },
    "visual-engineering": {
      "model": "openai/gpt-5.4",
      "reasoningEffort": "medium"
    }
  },
  "sisyphus_agent": {
    "default_builder_enabled": true,
    "planner_enabled": true,
    "replace_plan": false
  }
}
